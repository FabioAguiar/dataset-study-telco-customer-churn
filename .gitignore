# ============================================
# ⚙️ SISTEMA / EDITORES
# ============================================
.DS_Store
Thumbs.db
*.swp
*.swo

# ============================================
# 🐍 PYTHON
# ============================================
__pycache__/
*.py[cod]
*.pyo
*.pyd
.venv/
venv/
env/
dist/
build/
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# ============================================
# 📓 JUPYTER NOTEBOOKS
# ============================================
.ipynb_checkpoints/
*.nbconvert.ipynb
*.ipynb_checkpoints/

# ============================================
# 💡 IDE / PROJETO
# ============================================
.vscode/
.idea/

# ============================================
# 🔒 VARIÁVEIS DE AMBIENTE / CREDENCIAIS
# ============================================
.env
.env.*
*.env
secrets.*
credentials.*

# ============================================
# 📁 ESTRUTURA DE DADOS DO PROJETO
# ============================================
data/raw/
data/interim/
data/processed/
!data/.gitkeep
!data/README.md

# exportações diretas
processed.parquet

# ============================================
# 📑 RELATÓRIOS E LOGS
# ============================================
reports/*.log
reports/data_preparation.log
reports/manifest.json
reports/artifacts/**
reports/missing/**
reports/outliers/**
reports/nulls/**
!reports/.gitkeep
!reports/README.md

# logs genéricos e temporários
*.bak
*.tmp
*.old

# ============================================
# 🧱 ARTEFATOS E METADADOS
# ============================================
artifacts/**/*.json
artifacts/**/*.csv
artifacts/**/*.xlsx
artifacts/**/*.parquet
!artifacts/.gitkeep
!artifacts/README.md

# ============================================
# 📊 DASHBOARDS / IMPRESSÕES
# ============================================
dashboards/**
prints/**
!dashboards/.gitkeep
!dashboards/README.md
!prints/.gitkeep
!prints/README.md

# ============================================
# 🧾 LOGS GERAIS
# ============================================
*.log

# ============================================
# 🧩 MODELOS / CHECKPOINTS
# ============================================
*.joblib
*.pkl
*.pickle
*.sav

# ============================================
# ⚙️ CONFIGURAÇÕES LOCAIS
# ============================================
config/local.json
docs/project-status/*

# ============================================
# 🧪 TEMPORÁRIOS / BACKUPS
# ============================================
~$*
*_backup.*
*.bak-*
*.temp
*.tmp
